# Banco de dados (Neon/Postgres)
DATABASE_URL=

# Chave usada para assinar a sessão de login (gere uma string longa e aleatória)
SESSION_SECRET=

# E-mail transacional (Gmail)
# GMAIL_USER: endereço do Gmail usado só pelo site.
# GMAIL_APP_PASSWORD: "senha de app" de 16 caracteres gerada na conta Google
# (Segurança > Verificação em duas etapas > Senhas de app). NÃO é a senha normal.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=

# URL pública do site (usada em links de e-mail e no retorno do pagamento).
# Pode deixar em branco em desenvolvimento; em produção, coloque a URL da
# Vercel ou do domínio final, ex: https://stella-celeste.vercel.app
NEXT_PUBLIC_APP_URL=

# Mercado Pago — pagamento online (cartão / boleto / Pix)
# Sem essa chave, o site funciona normalmente e o admin marca "pago" à mão.
# Modo de teste: painel do Mercado Pago > Suas integrações > sua aplicação >
# Credenciais de teste > Access Token.
# Produção: use o Access Token de PRODUÇÃO da conta que vai receber o dinheiro.
MERCADOPAGO_ACCESS_TOKEN=
