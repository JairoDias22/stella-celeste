# Banco de dados (Neon/Postgres)
DATABASE_URL=

# Chave usada para assinar a sessão de login (gere uma string longa e aleatória)
SESSION_SECRET=

# E-mail transacional (Resend)
RESEND_API_KEY=
ADMIN_EMAIL=

# URL pública do site (usada em links de e-mail e no retorno do pagamento).
# Pode deixar em branco em desenvolvimento; em produção, coloque a URL da
# Vercel ou do domínio final, ex: https://stella-celeste.vercel.app
NEXT_PUBLIC_APP_URL=

# Mercado Pago — pagamento online (Pix / cartão)
# Deixe em branco por enquanto: sem essa chave, o site funciona normalmente
# e o admin continua marcando "pago" manualmente, como hoje.
# Quando for configurar: painel do Mercado Pago > Suas integrações > sua
# aplicação > Credenciais de teste (ou de produção) > Access Token.
MERCADOPAGO_ACCESS_TOKEN=
