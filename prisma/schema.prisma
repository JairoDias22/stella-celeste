generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Servico {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       String
  duration    String
  slots       Int       @default(0)
  createdAt   DateTime  @default(now())
  reservas    Reserva[]
}

// Modelo de recorrência: "toda Segunda às 14h" — configurado uma vez pelo admin.
model DisponibilidadeSemanal {
  id        String    @id @default(cuid())
  weekday   String    // "Segunda", "Terça", etc.
  time      String    // "14:00"
  ativo     Boolean   @default(true) // false = não gera mais horários novos
  createdAt DateTime  @default(now())
  horarios  Horario[]

  @@unique([weekday, time])
}

// Ocorrência real, com data específica, gerada a partir da DisponibilidadeSemanal.
model Horario {
  id                 String   @id @default(cuid())
  data               DateTime @db.Date // só a data (sem hora nem fuso) — evita ambiguidade na comparação
  weekday            String
  time               String
  available          Boolean  @default(true)
  createdAt          DateTime @default(now())

  disponibilidade    DisponibilidadeSemanal @relation(fields: [disponibilidadeId], references: [id], onDelete: Cascade)
  disponibilidadeId  String

  reservas           Reserva[]

  @@unique([disponibilidadeId, data])
}

model Cliente {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  phone               String?
  passwordHash        String
  avatarUrl           String?    @db.Text
  bio                 String?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime   @default(now())
  reservas            Reserva[]
  avaliacao           Avaliacao?
}

model Avaliacao {
  id         String   @id @default(cuid())
  nota       Int
  comentario String
  status     String   @default("pendente") // pendente | aprovada | recusada
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  String   @unique
}

model Admin {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime @default(now())
}

model Reserva {
  id               String    @id @default(cuid())
  status           String    @default("pendente") // pendente | pago | cancelado
  valor            Decimal   @db.Decimal(10, 2)
  metodoPagamento  String? // pix | cartao
  createdAt        DateTime  @default(now())

  servico    Servico  @relation(fields: [servicoId], references: [id])
  servicoId  String

  horario    Horario  @relation(fields: [horarioId], references: [id])
  horarioId  String

  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  String
}
