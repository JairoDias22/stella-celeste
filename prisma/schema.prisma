generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Servico {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       String
  duration    String
  slots       Int       @default(0)
  createdAt   DateTime  @default(now())
  reservas    Reserva[]
}

model Vaga {
  id        String   @id @default(cuid())
  weekday   String   // "Segunda", "Terça", etc.
  time      String   // "14:00"
  available Boolean  @default(true)
  reservas  Reserva[]
}

model Cliente {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  createdAt    DateTime  @default(now())
  reservas     Reserva[]
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Reserva {
  id               String    @id @default(cuid())
  status           String    @default("pendente") // pendente | pago | cancelado
  valor            Decimal   @db.Decimal(10, 2)
  metodoPagamento  String? // pix | cartao
  createdAt        DateTime  @default(now())

  servico    Servico  @relation(fields: [servicoId], references: [id])
  servicoId  String

  vaga       Vaga     @relation(fields: [vagaId], references: [id])
  vagaId     String

  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  String
}
