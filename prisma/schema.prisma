generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Servico {
  id        String   @id @default(cuid())
  name      String
  price     String
  duration  String
  slots     Int      @default(0)
  createdAt DateTime @default(now())
  reservas  Reserva[]
}

model Vaga {
  id        String   @id @default(cuid())
  weekday   String   // "Segunda", "Terça", etc.
  time      String   // "14:00"
  available Boolean  @default(true)
  reservas  Reserva[]
}

model Cliente {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  reservas  Reserva[]
}

model Reserva {
  id         String   @id @default(cuid())
  status     String   @default("pendente") // pendente | pago | cancelado
  createdAt  DateTime @default(now())

  servico    Servico  @relation(fields: [servicoId], references: [id])
  servicoId  String

  vaga       Vaga     @relation(fields: [vagaId], references: [id])
  vagaId     String

  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  String
}